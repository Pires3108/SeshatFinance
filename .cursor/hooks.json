{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard-git-commit.mjs",
        "matcher": "Shell",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/require-webhook-waiter.mjs",
        "matcher": "Shell",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
