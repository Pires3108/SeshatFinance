{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/registrations": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "maxLength": 320,
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": ["displayName", "email", "password"],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "enum": ["confirmation_required"],
                      "type": "string"
                    }
                  },
                  "required": ["status"],
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Register a user and request email confirmation",
        "tags": ["auth"]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "service": "api",
                    "status": "ok"
                  },
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": ["api"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["service", "status"],
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Check API liveness",
        "tags": ["health"]
      }
    }
  },
  "info": {
    "title": "Seshat Finance API",
    "description": "API para registrar e organizar informações financeiras.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
