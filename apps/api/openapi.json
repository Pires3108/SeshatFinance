{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/registrations": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "maxLength": 120,
                    "minLength": 1,
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "maxLength": 320,
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": ["displayName", "email", "password"],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "enum": ["confirmation_required"],
                      "type": "string"
                    }
                  },
                  "required": ["status"],
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Register a user and request email confirmation",
        "tags": ["auth"]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "service": "api",
                    "status": "ok"
                  },
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": ["api"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["service", "status"],
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Check API liveness",
        "tags": ["health"]
      }
    },
    "/api/v1/auth/password-recovery-requests": {
      "post": {
        "operationId": "PasswordRecoveryController_request",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 320,
                    "type": "string"
                  }
                },
                "required": ["email"],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The same response is returned whether the address exists or not.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "enum": ["accepted"],
                      "type": "string"
                    }
                  },
                  "required": ["status"],
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Request a password recovery email",
        "tags": ["auth"]
      }
    },
    "/api/v1/users/me/profile": {
      "get": {
        "operationId": "UserProfileController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "displayName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "presentationCurrency": {
                      "maxLength": 3,
                      "minLength": 3,
                      "type": "string"
                    },
                    "timeZone": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "version": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "createdAt",
                    "displayName",
                    "id",
                    "locale",
                    "presentationCurrency",
                    "timeZone",
                    "updatedAt",
                    "version"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "404": {
            "description": "Profile has not been created"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the authenticated user profile",
        "tags": ["users"]
      },
      "patch": {
        "operationId": "UserProfileController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "maxLength": 120,
                    "minLength": 1,
                    "nullable": true,
                    "type": "string"
                  },
                  "locale": {
                    "maxLength": 16,
                    "minLength": 2,
                    "type": "string"
                  },
                  "presentationCurrency": {
                    "maxLength": 3,
                    "minLength": 3,
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  "timeZone": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "displayName",
                  "locale",
                  "presentationCurrency",
                  "timeZone"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "displayName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "presentationCurrency": {
                      "maxLength": 3,
                      "minLength": 3,
                      "type": "string"
                    },
                    "timeZone": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "version": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "createdAt",
                    "displayName",
                    "id",
                    "locale",
                    "presentationCurrency",
                    "timeZone",
                    "updatedAt",
                    "version"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token missing or invalid"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create or update the authenticated user profile",
        "tags": ["users"]
      }
    }
  },
  "info": {
    "title": "Seshat Finance API",
    "description": "API para registrar e organizar informações financeiras.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
