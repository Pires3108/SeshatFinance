{
  "name": "@seshat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint scripts src test",
    "openapi:generate": "tsx scripts/generate-openapi.ts && prettier --write openapi.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-fastify": "latest",
    "@nestjs/swagger": "12.0.1",
    "@seshat/application": "workspace:*",
    "@seshat/database": "workspace:*",
    "@seshat/domain": "workspace:*",
    "@seshat/observability": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "latest",
    "@types/node": "latest",
    "tsx": "latest"
  }
}
