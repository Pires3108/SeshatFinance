generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id                   String   @id @db.Uuid
  displayName          String?  @map("display_name") @db.VarChar(120)
  locale               String   @default("pt-BR") @db.VarChar(16)
  timeZone             String   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  presentationCurrency String   @default("BRL") @map("presentation_currency") @db.Char(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int      @default(1)

  @@map("user_profiles")
}

enum AccountLifecycle {
  active
  archived
  trashed

  @@map("account_lifecycle")
}

model Account {
  id                       String              @id @db.Uuid
  ownerId                  String              @map("owner_id") @db.Uuid
  name                     String
  description              String?
  institution              String?
  typeKey                  String              @map("type_key")
  initialBalanceMinorUnits Decimal             @map("initial_balance_minor_units") @db.Decimal(1000, 0)
  currencyCode             String              @map("currency_code") @db.Char(3)
  currencyMinorUnitScale   Int                 @map("currency_minor_unit_scale") @db.SmallInt
  color                    String?
  icon                     String?
  lifecycle                AccountLifecycle    @default(active)
  archivedAt               DateTime?           @map("archived_at") @db.Timestamptz(6)
  trashedAt                DateTime?           @map("trashed_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @map("updated_at") @db.Timestamptz(6)
  version                  Int                 @default(1)
  transactions             Transaction[]
  balanceAdjustments       BalanceAdjustment[]
  creditCards              CreditCard[]

  @@unique([id, ownerId])
  @@index([ownerId, lifecycle])
  @@map("accounts")
}

model CreditCard {
  id                     String   @id @db.Uuid
  ownerId                String   @map("owner_id") @db.Uuid
  paymentAccountId       String   @map("payment_account_id") @db.Uuid
  paymentAccount         Account  @relation(fields: [paymentAccountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  name                   String
  brand                  String
  limitMinorUnits        Decimal  @map("limit_minor_units") @db.Decimal(1000, 0)
  currencyCode           String   @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int      @map("currency_minor_unit_scale") @db.SmallInt
  closingDay             Int      @map("closing_day") @db.SmallInt
  dueDay                 Int      @map("due_day") @db.SmallInt
  createdAt              DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@index([ownerId, createdAt, id])
  @@index([ownerId, paymentAccountId])
  @@map("credit_cards")
}

enum TransactionKind {
  income
  expense

  @@map("transaction_kind")
}

enum TransactionLifecycle {
  active
  archived
  trashed

  @@map("transaction_lifecycle")
}

model Transaction {
  id                     String               @id @db.Uuid
  ownerId                String               @map("owner_id") @db.Uuid
  accountId              String               @map("account_id") @db.Uuid
  account                Account              @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind                   TransactionKind
  amountMinorUnits       Decimal              @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String               @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                  @map("currency_minor_unit_scale") @db.SmallInt
  description            String?
  observations           String?
  occurredAt             DateTime             @map("occurred_at") @db.Timestamptz(6)
  lifecycle              TransactionLifecycle @default(active)
  archivedAt             DateTime?            @map("archived_at") @db.Timestamptz(6)
  trashedAt              DateTime?            @map("trashed_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @map("updated_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  tagAssignments         TransactionTag[]
  categoryId             String?              @map("category_id") @db.Uuid
  category               Category?            @relation("transaction_category", fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  subcategoryId          String?              @map("subcategory_id") @db.Uuid
  subcategory            Category?            @relation("transaction_subcategory", fields: [subcategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  costCenterId           String?              @map("cost_center_id") @db.Uuid
  costCenter             CostCenter?          @relation(fields: [costCenterId, ownerId], references: [id, ownerId], onDelete: Restrict)
  outgoingTransfer       Transfer?            @relation("transfer_source")
  incomingTransfer       Transfer?            @relation("transfer_destination")
  balanceAdjustment      BalanceAdjustment?

  @@unique([id, ownerId])
  @@index([ownerId, accountId, occurredAt])
  @@map("transactions")
}

model Transfer {
  id                       String      @id @db.Uuid
  ownerId                  String      @map("owner_id") @db.Uuid
  sourceTransactionId      String      @map("source_transaction_id") @db.Uuid
  sourceTransaction        Transaction @relation("transfer_source", fields: [sourceTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  destinationTransactionId String      @map("destination_transaction_id") @db.Uuid
  destinationTransaction   Transaction @relation("transfer_destination", fields: [destinationTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt                DateTime    @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([sourceTransactionId, ownerId])
  @@unique([destinationTransactionId, ownerId])
  @@index([ownerId, createdAt])
  @@map("transfers")
}

model BalanceAdjustment {
  id                        String      @id @db.Uuid
  ownerId                   String      @map("owner_id") @db.Uuid
  accountId                 String      @map("account_id") @db.Uuid
  account                   Account     @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  transactionId             String      @map("transaction_id") @db.Uuid
  transaction               Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  previousBalanceMinorUnits Decimal     @map("previous_balance_minor_units") @db.Decimal(1000, 0)
  reportedBalanceMinorUnits Decimal     @map("reported_balance_minor_units") @db.Decimal(1000, 0)
  differenceMinorUnits      Decimal     @map("difference_minor_units") @db.Decimal(1000, 0)
  currencyCode              String      @map("currency_code") @db.Char(3)
  currencyMinorUnitScale    Int         @map("currency_minor_unit_scale") @db.SmallInt
  justification             String
  createdAt                 DateTime    @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([transactionId, ownerId])
  @@index([ownerId, accountId, createdAt])
  @@map("balance_adjustments")
}

enum FinancialAuditAction {
  created
  updated
  archived
  unarchived
  moved_to_trash      @map("moved-to-trash")
  restored_from_trash @map("restored-from-trash")

  @@map("financial_audit_action")
}

enum FinancialAuditResourceType {
  account
  transaction
  transfer
  balance_adjustment @map("balance-adjustment")
  credit_card        @map("credit-card")

  @@map("financial_audit_resource_type")
}

model FinancialAuditEvent {
  id           String                     @id @db.Uuid
  ownerId      String                     @map("owner_id") @db.Uuid
  actorId      String                     @map("actor_id") @db.Uuid
  action       FinancialAuditAction
  resourceType FinancialAuditResourceType @map("resource_type")
  resourceId   String                     @map("resource_id") @db.Uuid
  occurredAt   DateTime                   @map("occurred_at") @db.Timestamptz(6)

  @@index([ownerId, occurredAt, id])
  @@index([ownerId, resourceType, resourceId, occurredAt])
  @@map("financial_audit_events")
}

model Category {
  id                         String        @id @db.Uuid
  ownerId                    String        @map("owner_id") @db.Uuid
  name                       String
  parentCategoryId           String?       @map("parent_category_id") @db.Uuid
  parentCategory             Category?     @relation("category_hierarchy", fields: [parentCategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  childCategories            Category[]    @relation("category_hierarchy")
  categorizedTransactions    Transaction[] @relation("transaction_category")
  subcategorizedTransactions Transaction[] @relation("transaction_subcategory")
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @map("updated_at") @db.Timestamptz(6)
  version                    Int           @default(1)

  @@unique([id, ownerId])
  @@index([ownerId, parentCategoryId])
  @@map("categories")
}

model Tag {
  id                     String           @id @db.Uuid
  ownerId                String           @map("owner_id") @db.Uuid
  name                   String
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @map("updated_at") @db.Timestamptz(6)
  version                Int              @default(1)
  transactionAssignments TransactionTag[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("tags")
}

model CostCenter {
  id           String        @id @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  name         String
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(6)
  version      Int           @default(1)
  transactions Transaction[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("cost_centers")
}

model TransactionTag {
  transactionId String      @map("transaction_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  tag           Tag         @relation(fields: [tagId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([transactionId, tagId])
  @@index([ownerId, tagId])
  @@map("transaction_tags")
}
