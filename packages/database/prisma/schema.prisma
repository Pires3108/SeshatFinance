generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id                   String   @id @db.Uuid
  displayName          String?  @map("display_name") @db.VarChar(120)
  locale               String   @default("pt-BR") @db.VarChar(16)
  timeZone             String   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  presentationCurrency String   @default("BRL") @map("presentation_currency") @db.Char(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int      @default(1)

  @@map("user_profiles")
}

enum AccountLifecycle {
  active
  archived
  trashed

  @@map("account_lifecycle")
}

model Account {
  id                       String           @id @db.Uuid
  ownerId                  String           @map("owner_id") @db.Uuid
  name                     String
  description              String?
  institution              String?
  typeKey                  String           @map("type_key")
  initialBalanceMinorUnits Decimal          @map("initial_balance_minor_units") @db.Decimal(1000, 0)
  currencyCode             String           @map("currency_code") @db.Char(3)
  currencyMinorUnitScale   Int              @map("currency_minor_unit_scale") @db.SmallInt
  color                    String?
  icon                     String?
  lifecycle                AccountLifecycle @default(active)
  archivedAt               DateTime?        @map("archived_at") @db.Timestamptz(6)
  trashedAt                DateTime?        @map("trashed_at") @db.Timestamptz(6)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @map("updated_at") @db.Timestamptz(6)
  version                  Int              @default(1)
  transactions             Transaction[]

  @@index([ownerId, lifecycle])
  @@unique([id, ownerId])
  @@map("accounts")
}

enum TransactionKind {
  income
  expense

  @@map("transaction_kind")
}

enum TransactionLifecycle {
  active
  archived
  trashed

  @@map("transaction_lifecycle")
}

model Transaction {
  id                     String               @id @db.Uuid
  ownerId                String               @map("owner_id") @db.Uuid
  accountId              String               @map("account_id") @db.Uuid
  account                Account              @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind                   TransactionKind
  amountMinorUnits       Decimal              @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String               @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                  @map("currency_minor_unit_scale") @db.SmallInt
  description            String?
  observations           String?
  occurredAt             DateTime             @map("occurred_at") @db.Timestamptz(6)
  lifecycle              TransactionLifecycle @default(active)
  archivedAt             DateTime?            @map("archived_at") @db.Timestamptz(6)
  trashedAt              DateTime?            @map("trashed_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @map("updated_at") @db.Timestamptz(6)
  version                Int                  @default(1)
  tagAssignments         TransactionTag[]
  categoryId             String?              @map("category_id") @db.Uuid
  category               Category?            @relation("transaction_category", fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  subcategoryId          String?              @map("subcategory_id") @db.Uuid
  subcategory            Category?            @relation("transaction_subcategory", fields: [subcategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  costCenterId           String?              @map("cost_center_id") @db.Uuid
  costCenter             CostCenter?          @relation(fields: [costCenterId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@unique([id, ownerId])
  @@index([ownerId, accountId, occurredAt])
  @@map("transactions")
}

model Category {
  id               String        @id @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  name             String
  parentCategoryId String?       @map("parent_category_id") @db.Uuid
  parentCategory   Category?     @relation("category_hierarchy", fields: [parentCategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  childCategories  Category[]    @relation("category_hierarchy")
  categorizedTransactions    Transaction[] @relation("transaction_category")
  subcategorizedTransactions Transaction[] @relation("transaction_subcategory")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @map("updated_at") @db.Timestamptz(6)
  version          Int           @default(1)

  @@unique([id, ownerId])
  @@index([ownerId, parentCategoryId])
  @@map("categories")
}

model Tag {
  id                     String           @id @db.Uuid
  ownerId                String           @map("owner_id") @db.Uuid
  name                   String
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @map("updated_at") @db.Timestamptz(6)
  version                Int              @default(1)
  transactionAssignments TransactionTag[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("tags")
}

model CostCenter {
  id           String        @id @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  name         String
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(6)
  version      Int           @default(1)
  transactions Transaction[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("cost_centers")
}

model TransactionTag {
  transactionId String      @map("transaction_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  tag           Tag         @relation(fields: [tagId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([transactionId, tagId])
  @@index([ownerId, tagId])
  @@map("transaction_tags")
}
