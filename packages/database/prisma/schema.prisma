generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CounterpartyType {
  person
  company
  institution

  @@map("counterparty_type")
}

enum CounterpartyStatus {
  active
  inactive
  merged
  eliminated

  @@map("counterparty_status")
}

model Counterparty {
  id            String             @id @db.Uuid
  ownerId       String             @map("owner_id") @db.Uuid
  name          String             @db.VarChar(200)
  type          CounterpartyType
  email         String?            @db.VarChar(254)
  phone         String?            @db.VarChar(40)
  document      String?            @db.VarChar(40)
  notes         String?            @db.VarChar(2000)
  status        CounterpartyStatus @default(active)
  mergedIntoId  String?            @map("merged_into_id") @db.Uuid
  mergedInto    Counterparty?      @relation("counterparty_merges", fields: [mergedIntoId, ownerId], references: [id, ownerId], onDelete: Restrict)
  mergedSources Counterparty[]     @relation("counterparty_merges")
  eliminatedAt  DateTime?          @map("eliminated_at") @db.Timestamptz(6)
  anonymizedAt  DateTime?          @map("anonymized_at") @db.Timestamptz(6)
  legalHold     Boolean            @default(false) @map("legal_hold")
  transactions  Transaction[]
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @map("updated_at") @db.Timestamptz(6)
  version       Int                @default(1)

  loans Loan[]

  @@unique([id, ownerId])
  @@index([ownerId, status, name])
  @@map("counterparties")
}

model RegistrationIntent {
  emailHash Bytes    @id @map("email_hash") @db.ByteA
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("registration_intents")
}

model UserProfile {
  id                    String   @id @db.Uuid
  registrationConfirmed Boolean  @default(true) @map("registration_confirmed")
  displayName           String?  @map("display_name") @db.VarChar(120)
  locale                String   @default("pt-BR") @db.VarChar(16)
  timeZone              String   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  presentationCurrency  String   @default("BRL") @map("presentation_currency") @db.Char(3)
  refundPresentation    String   @default("separate-income") @map("refund_presentation") @db.VarChar(32)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version               Int      @default(1)

  @@map("user_profiles")
}

model UserTimeZoneChange {
  id                   String   @id @db.Uuid
  ownerId              String   @map("owner_id") @db.Uuid
  previousTimeZone     String   @map("previous_time_zone") @db.VarChar(64)
  newTimeZone          String   @map("new_time_zone") @db.VarChar(64)
  scope                String   @db.VarChar(32)
  affectedTransactions Int      @map("affected_transactions")
  changedAt            DateTime @map("changed_at") @db.Timestamptz(6)

  @@index([ownerId, changedAt])
  @@map("user_time_zone_changes")
}

model UserSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

enum FamilyGroupRole {
  owner
  administrator
  member
  viewer

  @@map("family_group_role")
}

model FamilyGroup {
  id        String                  @id @db.Uuid
  createdAt DateTime                @map("created_at") @db.Timestamptz(6)
  members   FamilyGroupMembership[]

  @@map("family_groups")
}

model FamilyGroupMembership {
  groupId  String          @map("group_id") @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  role     FamilyGroupRole
  joinedAt DateTime        @map("joined_at") @db.Timestamptz(6)
  group    FamilyGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId, joinedAt, groupId])
  @@map("family_group_memberships")
}

enum AccountLifecycle {
  active
  archived
  trashed

  @@map("account_lifecycle")
}

model Account {
  id                       String              @id @db.Uuid
  agency                   String?
  ownerId                  String              @map("owner_id") @db.Uuid
  name                     String
  description              String?
  institution              String?
  typeKey                  String              @map("type_key")
  initialBalanceMinorUnits Decimal             @map("initial_balance_minor_units") @db.Decimal(1000, 0)
  currencyCode             String              @map("currency_code") @db.Char(3)
  currencyMinorUnitScale   Int                 @map("currency_minor_unit_scale") @db.SmallInt
  color                    String?
  icon                     String?
  lifecycle                AccountLifecycle    @default(active)
  archivedAt               DateTime?           @map("archived_at") @db.Timestamptz(6)
  trashedAt                DateTime?           @map("trashed_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @map("updated_at") @db.Timestamptz(6)
  version                  Int                 @default(1)
  transactions             Transaction[]
  balanceAdjustments       BalanceAdjustment[]
  creditCards              CreditCard[]
  goalLinks                GoalAccountLink[]
  reserve                  AccountReserve?

  @@unique([id, ownerId])
  @@index([ownerId, lifecycle])
  @@map("accounts")
}

model CreditCard {
  id                     String                @id @db.Uuid
  ownerId                String                @map("owner_id") @db.Uuid
  paymentAccountId       String                @map("payment_account_id") @db.Uuid
  paymentAccount         Account               @relation(fields: [paymentAccountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  name                   String
  brand                  String
  limitMinorUnits        Decimal               @map("limit_minor_units") @db.Decimal(1000, 0)
  currencyCode           String                @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                   @map("currency_minor_unit_scale") @db.SmallInt
  closingDay             Int                   @map("closing_day") @db.SmallInt
  dueDay                 Int                   @map("due_day") @db.SmallInt
  closingBoundary        String                @default("next-cycle") @map("closing_boundary") @db.VarChar(16)
  attentionDays          Int                   @default(5) @map("attention_days") @db.SmallInt
  version                Int                   @default(1)
  createdAt              DateTime              @map("created_at") @db.Timestamptz(6)
  purchases              CardPurchase[]
  installmentPlans       CardInstallmentPlan[]
  invoices               CardInvoice[]
  settlements            InvoiceSettlement[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt, id])
  @@index([ownerId, paymentAccountId])
  @@map("credit_cards")
}

enum TransactionKind {
  income
  expense

  @@map("transaction_kind")
}

enum TransactionLifecycle {
  active
  archived
  trashed

  @@map("transaction_lifecycle")
}

model Transaction {
  id                     String                   @id @db.Uuid
  ownerId                String                   @map("owner_id") @db.Uuid
  accountId              String                   @map("account_id") @db.Uuid
  account                Account                  @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind                   TransactionKind
  amountMinorUnits       Decimal                  @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String                   @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                      @map("currency_minor_unit_scale") @db.SmallInt
  description            String?
  observations           String?
  counterpartyId         String?                  @map("counterparty_id") @db.Uuid
  counterparty           Counterparty?            @relation(fields: [counterpartyId, ownerId], references: [id, ownerId], onDelete: Restrict)
  counterpartyName       String?                  @map("counterparty_name") @db.VarChar(200)
  occurredAt             DateTime                 @map("occurred_at") @db.Timestamptz(6)
  timeZone               String                   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  lifecycle              TransactionLifecycle     @default(active)
  archivedAt             DateTime?                @map("archived_at") @db.Timestamptz(6)
  trashedAt              DateTime?                @map("trashed_at") @db.Timestamptz(6)
  /// Terminal elimination from the trash (RII-026 option b); never deleted.
  eliminatedAt           DateTime?                @map("eliminated_at") @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @map("updated_at") @db.Timestamptz(6)
  version                Int                      @default(1)
  tagAssignments         TransactionTag[]
  categoryId             String?                  @map("category_id") @db.Uuid
  category               Category?                @relation("transaction_category", fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  subcategoryId          String?                  @map("subcategory_id") @db.Uuid
  subcategory            Category?                @relation("transaction_subcategory", fields: [subcategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  costCenterId           String?                  @map("cost_center_id") @db.Uuid
  costCenter             CostCenter?              @relation(fields: [costCenterId, ownerId], references: [id, ownerId], onDelete: Restrict)
  outgoingTransfer       Transfer?                @relation("transfer_source")
  incomingTransfer       Transfer?                @relation("transfer_destination")
  balanceAdjustment      BalanceAdjustment?
  idempotencyRecords     TransactionIdempotency[]
  revisions              TransactionRevision[]
  refundExpenseLinks     RefundLink[]             @relation("refund_expense")
  refundEntryLink        RefundLink?              @relation("refund_entry")
  goalContribution       GoalContributionSource?
  cardSettlement         InvoiceSettlement?

  @@unique([id, ownerId])
  @@index([ownerId, accountId, occurredAt])
  @@index([ownerId, counterpartyId])
  @@map("transactions")
}

model TransactionIdempotency {
  ownerId       String      @map("owner_id") @db.Uuid
  key           String      @db.VarChar(128)
  fingerprint   String
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@id([ownerId, key])
  @@map("transaction_idempotency")
}

model IdempotencyRecord {
  ownerId     String   @map("owner_id") @db.Uuid
  operation   String   @db.VarChar(64)
  key         String   @db.Uuid
  payloadHash String   @map("payload_hash") @db.Char(64)
  response    String
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([ownerId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model TransactionRevision {
  id              String      @id @db.Uuid
  ownerId         String      @map("owner_id") @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  transaction     Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  actorId         String      @map("actor_id") @db.Uuid
  previousVersion Int         @map("previous_version")
  newVersion      Int         @map("new_version")
  before          Json
  after           Json
  occurredAt      DateTime    @map("occurred_at") @db.Timestamptz(6)

  @@unique([transactionId, newVersion])
  @@index([ownerId, transactionId, newVersion])
  @@map("transaction_revisions")
}

enum RefundLinkKind {
  refund
  compensation

  @@map("refund_link_kind")
}

model RefundLink {
  id                   String         @id @db.Uuid
  ownerId              String         @map("owner_id") @db.Uuid
  expenseTransactionId String         @map("expense_transaction_id") @db.Uuid
  expenseTransaction   Transaction    @relation("refund_expense", fields: [expenseTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  entryTransactionId   String         @map("entry_transaction_id") @db.Uuid
  entryTransaction     Transaction    @relation("refund_entry", fields: [entryTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind                 RefundLinkKind
  compensatesRefundId  String?        @map("compensates_refund_id") @db.Uuid
  compensatesRefund    RefundLink?    @relation("refund_compensation", fields: [compensatesRefundId, ownerId], references: [id, ownerId], onDelete: Restrict)
  compensations        RefundLink[]   @relation("refund_compensation")
  requestFingerprint   String         @map("request_fingerprint") @db.Char(64)
  idempotencyKey       String         @map("idempotency_key") @db.Uuid
  reason               String?
  createdAt            DateTime       @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([entryTransactionId, ownerId])
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, expenseTransactionId])
  @@index([ownerId, compensatesRefundId])
  @@map("refund_links")
}

model Transfer {
  id                       String      @id @db.Uuid
  ownerId                  String      @map("owner_id") @db.Uuid
  sourceTransactionId      String      @map("source_transaction_id") @db.Uuid
  sourceTransaction        Transaction @relation("transfer_source", fields: [sourceTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  destinationTransactionId String      @map("destination_transaction_id") @db.Uuid
  destinationTransaction   Transaction @relation("transfer_destination", fields: [destinationTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt                DateTime    @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([sourceTransactionId, ownerId])
  @@unique([destinationTransactionId, ownerId])
  @@index([ownerId, createdAt])
  @@map("transfers")
}

model BalanceAdjustment {
  id                        String      @id @db.Uuid
  ownerId                   String      @map("owner_id") @db.Uuid
  accountId                 String      @map("account_id") @db.Uuid
  account                   Account     @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)
  transactionId             String      @map("transaction_id") @db.Uuid
  transaction               Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  previousBalanceMinorUnits Decimal     @map("previous_balance_minor_units") @db.Decimal(1000, 0)
  reportedBalanceMinorUnits Decimal     @map("reported_balance_minor_units") @db.Decimal(1000, 0)
  differenceMinorUnits      Decimal     @map("difference_minor_units") @db.Decimal(1000, 0)
  currencyCode              String      @map("currency_code") @db.Char(3)
  currencyMinorUnitScale    Int         @map("currency_minor_unit_scale") @db.SmallInt
  justification             String
  createdAt                 DateTime    @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([transactionId, ownerId])
  @@index([ownerId, accountId, createdAt])
  @@map("balance_adjustments")
}

enum FinancialAuditAction {
  created
  updated
  archived
  unarchived
  moved_to_trash      @map("moved-to-trash")
  restored_from_trash @map("restored-from-trash")
  eliminated
  closed

  @@map("financial_audit_action")
}

enum FinancialAuditResourceType {
  account
  transaction
  transfer
  balance_adjustment    @map("balance-adjustment")
  credit_card           @map("credit-card")
  card_purchase         @map("card-purchase")
  card_installment_plan @map("card-installment-plan")
  loan
  card_invoice          @map("card-invoice")
  invoice_settlement    @map("invoice-settlement")
  manual_exchange_quote @map("manual-exchange-quote")
  goal
  account_reserve       @map("account-reserve")
  goal_contribution     @map("goal-contribution")

  @@map("financial_audit_resource_type")
}

model FinancialAuditEvent {
  id            String                     @id @db.Uuid
  ownerId       String                     @map("owner_id") @db.Uuid
  actorId       String                     @map("actor_id") @db.Uuid
  action        FinancialAuditAction
  resourceType  FinancialAuditResourceType @map("resource_type")
  resourceId    String                     @map("resource_id") @db.Uuid
  occurredAt    DateTime                   @map("occurred_at") @db.Timestamptz(6)
  /// Assigned by the link_financial_audit_event trigger (ADR-036).
  ownerSequence BigInt                     @default(0) @map("owner_sequence")
  /// Assigned by the link_financial_audit_event trigger (ADR-036).
  previousHash  String                     @default(dbgenerated("repeat('0'::text, 64)")) @map("previous_hash") @db.Char(64)
  /// Assigned by the link_financial_audit_event trigger (ADR-036).
  hash          String                     @default(dbgenerated("repeat('0'::text, 64)")) @db.Char(64)
  result        String                     @default("succeeded") @db.VarChar(16)
  errorCode     String?                    @map("error_code") @db.VarChar(64)
  correlationId String?                    @map("correlation_id") @db.Uuid

  @@unique([ownerId, ownerSequence])
  @@index([ownerId, occurredAt, id])
  @@index([ownerId, resourceType, resourceId, occurredAt])
  @@map("financial_audit_events")
}

/// Last link of each owner's audit chain; maintained by a trigger.
model FinancialAuditChainHead {
  ownerId      String @id @map("owner_id") @db.Uuid
  lastSequence BigInt @map("last_sequence")
  lastHash     String @map("last_hash") @db.Char(64)

  @@map("financial_audit_chain_heads")
}

model ManualExchangeQuoteVersion {
  quoteId            String   @map("quote_id") @db.Uuid
  version            Int
  commandType        String   @map("command_type") @db.VarChar(8)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  ownerId            String   @map("owner_id") @db.Uuid
  authorId           String   @map("author_id") @db.Uuid
  sourceCurrencyCode String   @map("source_currency_code") @db.Char(3)
  targetCurrencyCode String   @map("target_currency_code") @db.Char(3)
  rate               String   @db.VarChar(1000)
  source             String   @db.VarChar(120)
  effectiveAt        DateTime @map("effective_at") @db.Timestamptz(6)
  recordedAt         DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([quoteId, version])
  @@unique([ownerId, commandType, idempotencyKey])
  @@index([ownerId, quoteId, version])
  @@index([ownerId, recordedAt, quoteId])
  @@map("manual_exchange_quote_versions")
}

model Category {
  id                         String        @id @db.Uuid
  ownerId                    String        @map("owner_id") @db.Uuid
  name                       String
  archivedAt                 DateTime?     @map("archived_at") @db.Timestamptz(6)
  parentCategoryId           String?       @map("parent_category_id") @db.Uuid
  parentCategory             Category?     @relation("category_hierarchy", fields: [parentCategoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  childCategories            Category[]    @relation("category_hierarchy")
  categorizedTransactions    Transaction[] @relation("transaction_category")
  subcategorizedTransactions Transaction[] @relation("transaction_subcategory")
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @map("updated_at") @db.Timestamptz(6)
  version                    Int           @default(1)

  cardPurchases CardPurchase[]

  @@unique([id, ownerId])
  @@index([ownerId, parentCategoryId])
  @@map("categories")
}

model CategoryCatalogInstallation {
  ownerId   String   @id @map("owner_id") @db.Uuid
  version   Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("category_catalog_installations")
}

model Tag {
  id                     String           @id @db.Uuid
  ownerId                String           @map("owner_id") @db.Uuid
  name                   String
  archivedAt             DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @map("updated_at") @db.Timestamptz(6)
  version                Int              @default(1)
  transactionAssignments TransactionTag[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("tags")
}

model CostCenter {
  id           String        @id @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  name         String
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(6)
  version      Int           @default(1)
  transactions Transaction[]

  @@unique([id, ownerId])
  @@index([ownerId, name])
  @@map("cost_centers")
}

model TransactionTag {
  transactionId String      @map("transaction_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  tag           Tag         @relation(fields: [tagId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([transactionId, tagId])
  @@index([ownerId, tagId])
  @@map("transaction_tags")
}

model UserHolidaySettings {
  ownerId          String   @id @map("owner_id") @db.Uuid
  stateCode        String?  @map("state_code") @db.Char(2)
  municipalityCode String?  @map("municipality_code") @db.Char(7)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("user_holiday_settings")
}

model UserDeclaredHoliday {
  id        String   @id @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(120)
  month     Int      @db.SmallInt
  day       Int      @db.SmallInt
  year      Int?     @db.SmallInt
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@index([ownerId, month, day])
  @@map("user_declared_holidays")
}

model CardPurchase {
  id                     String                @id @db.Uuid
  ownerId                String                @map("owner_id") @db.Uuid
  cardId                 String                @map("card_id") @db.Uuid
  card                   CreditCard            @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Restrict)
  categoryId             String?               @map("category_id") @db.Uuid
  category               Category?             @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict)
  amountMinorUnits       Decimal               @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String                @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                   @map("currency_minor_unit_scale") @db.SmallInt
  description            String                @db.VarChar(500)
  externalId             String?               @map("external_id") @db.VarChar(255)
  occurredAt             DateTime              @map("occurred_at") @db.Timestamptz(6)
  cycleClosesOn          DateTime              @map("cycle_closes_on") @db.Date
  postedAfterClose       Boolean               @default(false) @map("posted_after_close")
  createdAt              DateTime              @map("created_at") @db.Timestamptz(6)
  installmentPlans       CardInstallmentPlan[]

  @@unique([id, ownerId])
  @@index([ownerId, cardId, cycleClosesOn, occurredAt])
  @@map("card_purchases")
}

model CardInstallmentPlan {
  id                     String                      @id @db.Uuid
  ownerId                String                      @map("owner_id") @db.Uuid
  cardId                 String                      @map("card_id") @db.Uuid
  card                   CreditCard                  @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Restrict)
  /// Unique among root plans (partial index in SQL); renegotiated plans repeat it.
  purchaseId             String                      @map("purchase_id") @db.Uuid
  purchase               CardPurchase                @relation(fields: [purchaseId, ownerId], references: [id, ownerId], onDelete: Restrict)
  calculationVersion     Int                         @map("calculation_version")
  installmentCount       Int                         @map("installment_count") @db.SmallInt
  rateMethod             String?                     @map("rate_method") @db.VarChar(16)
  ratePercentPerPeriod   String?                     @map("rate_percent_per_period") @db.VarChar(16)
  ratePeriodicity        String?                     @map("rate_periodicity") @db.VarChar(16)
  principalMinorUnits    Decimal                     @map("principal_minor_units") @db.Decimal(1000, 0)
  interestMinorUnits     Decimal                     @map("interest_minor_units") @db.Decimal(1000, 0)
  totalMinorUnits        Decimal                     @map("total_minor_units") @db.Decimal(1000, 0)
  currencyCode           String                      @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                         @map("currency_minor_unit_scale") @db.SmallInt
  status                 String                      @default("active") @db.VarChar(16)
  renegotiatedFromId     String?                     @map("renegotiated_from_id") @db.Uuid
  renegotiatedFrom       CardInstallmentPlan?        @relation("card_plan_renegotiations", fields: [renegotiatedFromId, ownerId], references: [id, ownerId], onDelete: Restrict)
  renegotiations         CardInstallmentPlan[]       @relation("card_plan_renegotiations")
  createdAt              DateTime                    @map("created_at") @db.Timestamptz(6)
  installments           CardInstallment[]
  changes                CardInstallmentPlanChange[]

  @@unique([id, ownerId])
  @@index([ownerId, cardId])
  @@index([ownerId, purchaseId])
  @@map("card_installment_plans")
}

model CardInstallment {
  id                     String              @id @db.Uuid
  ownerId                String              @map("owner_id") @db.Uuid
  planId                 String              @map("plan_id") @db.Uuid
  plan                   CardInstallmentPlan @relation(fields: [planId, ownerId], references: [id, ownerId], onDelete: Restrict)
  cardId                 String              @map("card_id") @db.Uuid
  number                 Int                 @db.SmallInt
  amountMinorUnits       Decimal             @map("amount_minor_units") @db.Decimal(1000, 0)
  principalMinorUnits    Decimal             @map("principal_minor_units") @db.Decimal(1000, 0)
  interestMinorUnits     Decimal             @map("interest_minor_units") @db.Decimal(1000, 0)
  currencyCode           String              @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                 @map("currency_minor_unit_scale") @db.SmallInt
  cycleClosesOn          DateTime            @map("cycle_closes_on") @db.Date

  @@unique([planId, number])
  @@index([ownerId, cardId, cycleClosesOn])
  @@map("card_installments")
}

model CardInvoice {
  id                     String     @id @db.Uuid
  ownerId                String     @map("owner_id") @db.Uuid
  cardId                 String     @map("card_id") @db.Uuid
  card                   CreditCard @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Restrict)
  closesOn               DateTime   @map("closes_on") @db.Date
  firstPurchaseDate      DateTime   @map("first_purchase_date") @db.Date
  lastPurchaseDate       DateTime   @map("last_purchase_date") @db.Date
  scheduledDueOn         DateTime   @map("scheduled_due_on") @db.Date
  dueOn                  DateTime   @map("due_on") @db.Date
  closingBoundary        String     @map("closing_boundary") @db.VarChar(16)
  configurationPending   Boolean    @map("configuration_pending")
  holidayDatasetVersion  String     @map("holiday_dataset_version") @db.VarChar(40)
  timeZone               String     @map("time_zone") @db.VarChar(64)
  currencyCode           String     @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int        @map("currency_minor_unit_scale") @db.SmallInt
  status                 String     @db.VarChar(8)
  closedAt               DateTime?  @map("closed_at") @db.Timestamptz(6)
  closedTotalMinorUnits  Decimal?   @map("closed_total_minor_units") @db.Decimal(1000, 0)
  createdAt              DateTime   @map("created_at") @db.Timestamptz(6)
  version                Int        @default(1)

  @@unique([id, ownerId])
  @@unique([ownerId, cardId, closesOn])
  @@map("card_invoices")
}

model InvoiceSettlement {
  id                     String      @id @db.Uuid
  ownerId                String      @map("owner_id") @db.Uuid
  cardId                 String      @map("card_id") @db.Uuid
  card                   CreditCard  @relation(fields: [cardId, ownerId], references: [id, ownerId], onDelete: Restrict)
  invoiceClosesOn        DateTime    @map("invoice_closes_on") @db.Date
  accountId              String      @map("account_id") @db.Uuid
  transactionId          String      @unique @map("transaction_id") @db.Uuid
  transaction            Transaction @relation(fields: [transactionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  amountMinorUnits       Decimal     @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String      @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int         @map("currency_minor_unit_scale") @db.SmallInt
  paidAt                 DateTime    @map("paid_at") @db.Timestamptz(6)
  createdAt              DateTime    @map("created_at") @db.Timestamptz(6)

  @@unique([id, ownerId])
  @@unique([transactionId, ownerId])
  @@index([ownerId, cardId, invoiceClosesOn])
  @@map("invoice_settlements")
}

model Loan {
  id                     String            @id @db.Uuid
  ownerId                String            @map("owner_id") @db.Uuid
  direction              String            @db.VarChar(16)
  counterpartyId         String?           @map("counterparty_id") @db.Uuid
  counterparty           Counterparty?     @relation(fields: [counterpartyId, ownerId], references: [id, ownerId], onDelete: Restrict)
  description            String            @db.VarChar(500)
  principalMinorUnits    Decimal           @map("principal_minor_units") @db.Decimal(1000, 0)
  currencyCode           String            @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int               @map("currency_minor_unit_scale") @db.SmallInt
  contractedOn           DateTime          @map("contracted_on") @db.Date
  firstDueOn             DateTime          @map("first_due_on") @db.Date
  installmentCount       Int               @map("installment_count") @db.SmallInt
  rateMethod             String?           @map("rate_method") @db.VarChar(16)
  ratePercentPerPeriod   String?           @map("rate_percent_per_period") @db.VarChar(16)
  ratePeriodicity        String?           @map("rate_periodicity") @db.VarChar(16)
  profile                String            @db.VarChar(16)
  declaredAmounts        String[]          @map("declared_amounts")
  lateFeePercent         String?           @map("late_fee_percent") @db.VarChar(16)
  businessDayRule        String            @map("business_day_rule") @db.VarChar(24)
  allocationOrder        String[]          @map("allocation_order")
  calculationVersion     Int               @map("calculation_version")
  renegotiatedFromId     String?           @map("renegotiated_from_id") @db.Uuid
  renegotiatedFrom       Loan?             @relation("loan_renegotiations", fields: [renegotiatedFromId, ownerId], references: [id, ownerId], onDelete: Restrict)
  renegotiations         Loan[]            @relation("loan_renegotiations")
  createdAt              DateTime          @map("created_at") @db.Timestamptz(6)
  installments           LoanInstallment[]
  events                 LoanEvent[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@map("loans")
}

model LoanInstallment {
  loanId              String   @map("loan_id") @db.Uuid
  ownerId             String   @map("owner_id") @db.Uuid
  loan                Loan     @relation(fields: [loanId, ownerId], references: [id, ownerId], onDelete: Restrict)
  number              Int      @db.SmallInt
  scheduledDueOn      DateTime @map("scheduled_due_on") @db.Date
  dueOn               DateTime @map("due_on") @db.Date
  amountMinorUnits    Decimal  @map("amount_minor_units") @db.Decimal(1000, 0)
  principalMinorUnits Decimal  @map("principal_minor_units") @db.Decimal(1000, 0)
  interestMinorUnits  Decimal  @map("interest_minor_units") @db.Decimal(1000, 0)

  @@id([loanId, number])
  @@map("loan_installments")
}

model LoanEvent {
  id                    String    @id @db.Uuid
  ownerId               String    @map("owner_id") @db.Uuid
  loanId                String    @map("loan_id") @db.Uuid
  loan                  Loan      @relation(fields: [loanId, ownerId], references: [id, ownerId], onDelete: Restrict)
  sequence              Int
  kind                  String    @db.VarChar(16)
  occurredOn            DateTime? @map("occurred_on") @db.Date
  amountMinorUnits      Decimal?  @map("amount_minor_units") @db.Decimal(1000, 0)
  discountMinorUnits    Decimal?  @map("discount_minor_units") @db.Decimal(1000, 0)
  declaredFeeMinorUnits Decimal?  @map("declared_fee_minor_units") @db.Decimal(1000, 0)
  allocationOrder       String[]  @map("allocation_order")
  excess                String?   @db.VarChar(24)
  reversedEventId       String?   @map("reversed_event_id") @db.Uuid
  reason                String?   @db.VarChar(500)
  newLoanId             String?   @map("new_loan_id") @db.Uuid
  recordedAt            DateTime  @map("recorded_at") @db.Timestamptz(6)

  @@unique([loanId, sequence])
  @@index([ownerId, loanId])
  @@map("loan_events")
}

/// Append-only changes of a card installment plan (US-046, ADR-042).
model CardInstallmentPlanChange {
  id                     String              @id @db.Uuid
  ownerId                String              @map("owner_id") @db.Uuid
  planId                 String              @map("plan_id") @db.Uuid
  plan                   CardInstallmentPlan @relation(fields: [planId, ownerId], references: [id, ownerId], onDelete: Restrict)
  sequence               Int
  kind                   String              @db.VarChar(16)
  effectiveCycleClosesOn DateTime?           @map("effective_cycle_closes_on") @db.Date
  amountMinorUnits       Decimal?            @map("amount_minor_units") @db.Decimal(1000, 0)
  discountMinorUnits     Decimal?            @map("discount_minor_units") @db.Decimal(1000, 0)
  newPlanId              String?             @map("new_plan_id") @db.Uuid
  reversedChangeId       String?             @map("reversed_change_id") @db.Uuid
  reason                 String?             @db.VarChar(500)
  recordedAt             DateTime            @map("recorded_at") @db.Timestamptz(6)

  @@unique([planId, sequence])
  @@index([ownerId, planId])
  @@map("card_installment_plan_changes")
}

/// US-049 / ADR-043: goals declared by the holder. They organize progress
/// only and never record transactions (INV-026).
model Goal {
  id                     String            @id @db.Uuid
  ownerId                String            @map("owner_id") @db.Uuid
  name                   String            @db.VarChar(120)
  targetMinorUnits       Decimal           @map("target_minor_units") @db.Decimal(1000, 0)
  initialMinorUnits      Decimal           @map("initial_minor_units") @db.Decimal(1000, 0)
  currencyCode           String            @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int               @map("currency_minor_unit_scale") @db.SmallInt
  deadline               DateTime?         @db.Date
  mode                   String            @db.VarChar(16)
  lifecycle              String            @db.VarChar(16)
  createdAt              DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @map("updated_at") @db.Timestamptz(6)
  version                Int
  links                  GoalAccountLink[]
  contributions          GoalContribution[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@map("goals")
}

/// RN-069: the part of an account balance that counts for a goal.
model GoalAccountLink {
  goalId                      String   @map("goal_id") @db.Uuid
  ownerId                     String   @map("owner_id") @db.Uuid
  accountId                   String   @map("account_id") @db.Uuid
  position                    Int      @db.SmallInt
  shareKind                   String   @map("share_kind") @db.VarChar(16)
  shareMinorUnits             Decimal? @map("share_minor_units") @db.Decimal(1000, 0)
  shareCurrencyCode           String?  @map("share_currency_code") @db.Char(3)
  shareCurrencyMinorUnitScale Int?     @map("share_currency_minor_unit_scale") @db.SmallInt
  goal                        Goal     @relation(fields: [goalId, ownerId], references: [id, ownerId], onDelete: Cascade)
  account                     Account  @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@id([goalId, accountId])
  @@index([ownerId, accountId])
  @@map("goal_account_links")
}

/// RN-071 / US-051: the declared reserve of an account. Organizational only:
/// the book balance and net worth do not change (INV-012, INV-013).
model AccountReserve {
  accountId              String   @id @map("account_id") @db.Uuid
  ownerId                String   @map("owner_id") @db.Uuid
  amountMinorUnits       Decimal  @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String   @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int      @map("currency_minor_unit_scale") @db.SmallInt
  createdAt              DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @map("updated_at") @db.Timestamptz(6)
  version                Int
  account                Account  @relation(fields: [accountId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([accountId, ownerId])
  @@index([ownerId])
  @@map("account_reserves")
}

/// RN-070 / US-050: how one eligible entry is split between goals. The entry
/// keeps its full value in the balance (INV-026); the lines never exceed it
/// (INV-025). Rows are kept when the entry goes to the trash.
model GoalContributionSource {
  sourceTransactionId String             @id @map("source_transaction_id") @db.Uuid
  ownerId             String             @map("owner_id") @db.Uuid
  authorId            String             @map("author_id") @db.Uuid
  createdAt           DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @map("updated_at") @db.Timestamptz(6)
  version             Int
  transaction         Transaction        @relation(fields: [sourceTransactionId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Cascade)
  lines               GoalContribution[]

  @@unique([sourceTransactionId, ownerId])
  @@index([ownerId])
  @@map("goal_contribution_sources")
}

model GoalContribution {
  sourceTransactionId    String                 @map("source_transaction_id") @db.Uuid
  goalId                 String                 @map("goal_id") @db.Uuid
  ownerId                String                 @map("owner_id") @db.Uuid
  position               Int                    @db.SmallInt
  amountMinorUnits       Decimal                @map("amount_minor_units") @db.Decimal(1000, 0)
  currencyCode           String                 @map("currency_code") @db.Char(3)
  currencyMinorUnitScale Int                    @map("currency_minor_unit_scale") @db.SmallInt
  source                 GoalContributionSource @relation(fields: [sourceTransactionId, ownerId], references: [sourceTransactionId, ownerId], onDelete: Cascade, onUpdate: Cascade)
  goal                   Goal                   @relation(fields: [goalId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Cascade)

  @@id([sourceTransactionId, goalId])
  @@index([ownerId, goalId])
  @@map("goal_contributions")
}
